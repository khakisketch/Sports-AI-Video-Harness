      "source": "agents/creative-director.md",
      "skills": [
        "sports-video-consultation"
      ],
      "stages": [
        "all"
      ],
      "claude_tools": null
    },
    {
      "id": "research-script",
      "label": "조사·대본",
      "description": "근거 조사, 교육 순서와 대본을 작성해 감독에게 반환한다. 제작 실행과 승인 변경은 하지 않는다.",
      "source": "agents/research-script.md",
      "skills": [
        "sports-video-consultation"
      ],
      "stages": [
        "preproduction",
        "asset"
      ],
      "claude_tools": "Read, Glob, Grep, WebSearch, WebFetch"
