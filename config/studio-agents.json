{
  "schema_version": 1,
  "execution_model": "native_host_director_with_scoped_subagents_and_local_media_worker",
  "model_policy": "inherit_operator_selected_model; no automatic model downgrade or new API provider",
  "worker": "scripts/media_worker.py",
  "canonical_records": [
    "plan.json",
    "reviews.json",
    "jobs.json"
  ],
  "review_isolation": "fresh_context_without_director_verdict_or_prior_reviews",
  "agents": [
    {
      "id": "creative-director",
      "label": "총괄 제작 감독",
